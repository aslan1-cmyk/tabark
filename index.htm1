<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>tabark — дизайнерская одежда</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#181510;
    --ink-soft:#2a251d;
    --cream:#f6f2e9;
    --paper:#efe9dc;
    --clay:#a9906d;
    --moss:#4a5140;
    --line:rgba(24,21,16,0.14);
    --line-light:rgba(246,242,233,0.22);
    --serif:'Fraunces', serif;
    --sans:'Inter', sans-serif;
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--sans);
    background:var(--cream);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}
  img{background:linear-gradient(155deg,#e7ded0,#c4b89c);}
  .photo-cover{width:100%;height:100%;object-fit:cover;object-position:center 18%;}
  button{font-family:inherit;background:none;border:none;cursor:pointer;color:inherit;}
  ul{list-style:none;}

  .wrap{max-width:1280px;margin:0 auto;padding:0 40px;}

  /* ---------- HEADER ---------- */
  header{
    position:absolute;top:0;left:0;right:0;
    z-index:40;
    padding:28px 0;
  }
  .header-row{
    display:flex;align-items:center;justify-content:space-between;
    gap:24px;
  }
  .brand{
    font-family:var(--serif);
    font-size:26px;
    font-weight:400;
    letter-spacing:0.5px;
    color:var(--cream);
  }
  nav.primary-nav ul{
    display:flex;gap:34px;
  }
  nav.primary-nav a{
    font-size:13px;
    letter-spacing:0.04em;
    color:var(--cream);
    opacity:0.88;
    transition:opacity .2s ease;
    position:relative;
    padding-bottom:4px;
  }
  nav.primary-nav a:hover{opacity:1;}
  nav.primary-nav a::after{
    content:"";position:absolute;left:0;bottom:0;width:0;height:1px;
    background:var(--cream);transition:width .25s ease;
  }
  nav.primary-nav a:hover::after{width:100%;}

  .header-actions{
    display:flex;align-items:center;gap:22px;
  }
  .icon-btn{
    display:flex;align-items:center;gap:8px;
    font-size:13px;color:var(--cream);
  }
  .icon-btn svg{width:18px;height:18px;stroke:var(--cream);}
  .cart-count{
    font-size:11px;
    border:1px solid var(--line-light);
    border-radius:50%;
    width:18px;height:18px;
    display:flex;align-items:center;justify-content:center;
  }
  .menu-toggle{
    display:none;
    width:26px;height:18px;position:relative;
  }
  .menu-toggle span{
    position:absolute;left:0;right:0;height:1.5px;background:var(--cream);
    transition:all .3s ease;
  }
  .menu-toggle span:nth-child(1){top:0;}
  .menu-toggle span:nth-child(2){top:8px;}
  .menu-toggle span:nth-child(3){top:16px;}
  .menu-toggle.open span:nth-child(1){transform:translateY(8px) rotate(45deg);}
  .menu-toggle.open span:nth-child(2){opacity:0;}
  .menu-toggle.open span:nth-child(3){transform:translateY(-8px) rotate(-45deg);}

  /* mobile nav overlay */
  .mobile-nav{
    position:fixed;inset:0;background:var(--ink);
    z-index:60;
    display:flex;flex-direction:column;
    justify-content:center;align-items:flex-start;
    padding:0 40px;
    transform:translateY(-100%);
    transition:transform .4s cubic-bezier(.7,0,.3,1);
  }
  .mobile-nav.open{transform:translateY(0);}
  .mobile-nav ul{width:100%;}
  .mobile-nav li{border-top:1px solid var(--line-light);}
  .mobile-nav li:last-child{border-bottom:1px solid var(--line-light);}
  .mobile-nav a{
    display:block;padding:20px 0;
    font-family:var(--serif);font-size:30px;color:var(--cream);
  }
  .mobile-nav-close{
    position:absolute;top:28px;right:32px;
    width:26px;height:26px;
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    background:linear-gradient(180deg,#1c1812 0%, #14120e 60%, #100e0b 100%);
    display:flex;flex-direction:column;
    color:var(--cream);
    overflow:hidden;
  }
  .hero-figure{
    position:absolute;
    right:0;top:0;bottom:0;
    width:56%;
    overflow:hidden;
  }
  .hero-figure::before{
    content:"";position:absolute;inset:0;z-index:2;
    background:linear-gradient(90deg, var(--ink) 0%, rgba(24,21,16,0.15) 30%, rgba(24,21,16,0) 55%);
  }
  .hero-figure img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:60% 20%;}
  .hero-body{
    flex:1;
    display:flex;align-items:center;
    padding-top:100px;
    position:relative;
    z-index:5;
  }
  .hero-content{max-width:560px;}
  .hero-eyebrow{
    font-size:13px;letter-spacing:0.14em;color:var(--clay);
    margin-bottom:22px;
  }
  .hero-title{
    font-family:var(--serif);
    font-weight:400;
    font-size:clamp(64px,10vw,132px);
    line-height:0.92;
    letter-spacing:-0.01em;
  }
  .hero-sub{
    margin-top:26px;
    font-size:17px;line-height:1.6;
    color:rgba(246,242,233,0.72);
    max-width:400px;
  }
  .hero-cta{
    margin-top:38px;
    display:inline-flex;align-items:center;gap:14px;
    font-size:14px;letter-spacing:0.03em;
    padding-bottom:6px;border-bottom:1px solid var(--line-light);
  }
  .hero-cta svg{width:16px;height:16px;transition:transform .25s ease;}
  .hero-cta:hover svg{transform:translateX(5px);}

  .hero-scroll{
    position:absolute;left:40px;bottom:34px;
    display:flex;align-items:center;gap:14px;
    font-size:12px;color:rgba(246,242,233,0.55);
  }
  .hero-scroll .line{width:40px;height:1px;background:rgba(246,242,233,0.4);}

  /* decorative garment illustration */
  .garment-art{width:100%;height:100%;}

  /* ---------- SECTION HEADINGS ---------- */
  .section{padding:110px 0;}
  .section-tight{padding:80px 0;}
  .section-head{
    display:flex;justify-content:space-between;align-items:flex-end;
    margin-bottom:56px;gap:24px;flex-wrap:wrap;
  }
  .section-head h2{
    font-family:var(--serif);font-weight:400;
    font-size:clamp(34px,4vw,52px);
    max-width:520px;
  }
  .section-head p{
    max-width:320px;font-size:14px;line-height:1.6;
    color:var(--ink-soft);opacity:0.72;
  }

  /* ---------- CATEGORIES ---------- */
  .cat-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:26px;
  }
  .cat-card{display:block;}
  .cat-frame{
    aspect-ratio:3/4;border-radius:2px;overflow:hidden;
    background:linear-gradient(155deg,var(--paper),#ddd3bd);
    position:relative;
    margin-bottom:18px;
  }
  .cat-frame svg{
    position:absolute;inset:0;width:100%;height:100%;
  }
  .cat-name{
    display:flex;justify-content:space-between;align-items:center;
    font-size:14px;letter-spacing:0.02em;
    padding-bottom:14px;border-bottom:1px solid var(--line);
  }
  .cat-name svg{width:15px;height:15px;transition:transform .2s ease;}
  .cat-card:hover .cat-name svg{transform:translateX(4px);}
  .cat-card:hover .cat-frame{filter:brightness(0.97);}

  /* ---------- ABOUT / FEATURE ---------- */
  .feature{
    display:grid;grid-template-columns:1fr 1fr;
    align-items:stretch;
  }
  .feature-media{
    background:var(--ink);
    min-height:560px;position:relative;overflow:hidden;
  }
  .feature-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(0.15) contrast(1.03);}
  .feature-copy{
    background:var(--moss);color:var(--cream);
    padding:80px 64px;
    display:flex;flex-direction:column;justify-content:center;
  }
  .feature-copy .kicker{
    font-size:13px;letter-spacing:0.1em;color:var(--clay);margin-bottom:20px;
  }
  .feature-copy h2{
    font-family:var(--serif);font-weight:400;
    font-size:clamp(32px,3.4vw,46px);
    line-height:1.12;
    margin-bottom:26px;
  }
  .feature-copy p{
    font-size:15px;line-height:1.75;
    color:rgba(246,242,233,0.78);
    max-width:400px;margin-bottom:32px;
  }
  .feature-copy .hero-cta{border-color:var(--line-light);}

  /* ---------- NEW COLLECTION STRIP ---------- */
  .strip{
    display:grid;grid-template-columns:0.9fr 1fr 1fr 1fr;
    gap:22px;align-items:center;
  }
  .strip-intro{padding-right:20px;}
  .strip-intro .kicker{
    font-size:13px;letter-spacing:0.1em;color:var(--clay);margin-bottom:18px;
  }
  .strip-intro h3{
    font-family:var(--serif);font-weight:400;
    font-size:clamp(30px,3.2vw,42px);line-height:1.08;margin-bottom:26px;
  }
  .strip-frame{
    aspect-ratio:3/4.4;border-radius:2px;overflow:hidden;position:relative;
    background:var(--paper);
  }
  .strip-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}

  /* ---------- NEWSLETTER / FOOTER ---------- */
  footer{
    background:var(--ink);color:rgba(246,242,233,0.82);
    padding-top:90px;
  }
  .footer-top{
    display:grid;grid-template-columns:1.2fr 1.2fr 1fr;gap:40px;
    padding-bottom:70px;border-bottom:1px solid var(--line-light);
  }
  .footer-col h4{
    font-size:13px;letter-spacing:0.06em;margin-bottom:22px;color:var(--cream);
  }
  .footer-col li{margin-bottom:12px;font-size:14px;opacity:0.75;}
  .footer-col li a:hover{opacity:1;}
  .newsletter p{font-size:14px;opacity:0.7;margin-bottom:22px;max-width:320px;line-height:1.6;}
  .newsletter-form{
    display:flex;border-bottom:1px solid var(--line-light);padding-bottom:12px;max-width:340px;
  }
  .newsletter-form input{
    flex:1;background:none;border:none;color:var(--cream);font-size:14px;font-family:inherit;
  }
  .newsletter-form input::placeholder{color:rgba(246,242,233,0.45);}
  .newsletter-form button svg{width:18px;height:18px;stroke:var(--cream);}
  .footer-brand{
    font-family:var(--serif);font-size:24px;color:var(--cream);margin-bottom:18px;
  }
  .footer-bottom{
    display:flex;justify-content:space-between;align-items:center;
    padding:26px 0 34px;font-size:12.5px;opacity:0.55;flex-wrap:wrap;gap:12px;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:1024px){
    .wrap{padding:0 28px;}
    .cat-grid{grid-template-columns:repeat(2,1fr);}
    .strip{grid-template-columns:1fr 1fr;}
    .strip-intro{grid-column:1 / -1;padding-right:0;}
    .footer-top{grid-template-columns:1fr 1fr;}
  }

  @media (max-width:760px){
    nav.primary-nav{display:none;}
    .header-actions .icon-label{display:none;}
    .menu-toggle{display:block;}
    .hero{min-height:100svh;}
    .hero-figure{width:100%;opacity:0.9;}
    .hero-body{padding-top:120px;align-items:flex-start;}
    .hero-content{max-width:100%;}
    .hero-title{font-size:clamp(52px,17vw,84px);}
    .section{padding:70px 0;}
    .section-head{margin-bottom:36px;}
    .cat-grid{grid-template-columns:repeat(2,1fr);gap:16px;}
    .feature{grid-template-columns:1fr;}
    .feature-media{min-height:340px;}
    .feature-copy{padding:56px 28px;}
    .strip-frame{aspect-ratio:3/4;}
    .footer-top{grid-template-columns:1fr;gap:44px;padding-bottom:44px;}
    .footer-bottom{flex-direction:column;align-items:flex-start;}
  }

  @media (max-width:460px){
    .wrap{padding:0 20px;}
    .cat-grid{grid-template-columns:1fr;}
    .strip{grid-template-columns:1fr;}
  }

  /* reduced motion */
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    *{transition:none !important;}
  }
</style>
</head>
<body>

<header>
  <div class="wrap header-row">
    <div class="brand">tabark</div>
    <nav class="primary-nav">
      <ul>
        <li><a href="#collection">Коллекция</a></li>
        <li><a href="#shop">Магазин</a></li>
        <li><a href="#about">О бренде</a></li>
        <li><a href="#news">Новости</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <div class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        <span class="icon-label">Поиск</span>
      </div>
      <div class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4"><path d="M12 20s-7.5-4.6-9.6-9.1C1.1 7.8 2.6 4.8 5.7 4.2c2-.4 3.7.7 4.9 2.3C11.9 4.9 13.6 3.8 15.6 4.2c3.1.6 4.6 3.6 3.3 6.7C16.8 15.4 12 20 12 20z"/></svg>
        <span class="icon-label">Избранное</span>
      </div>
      <div class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="icon-label">Корзина</span>
        <span class="cart-count">0</span>
      </div>
      <button class="menu-toggle" id="menuToggle" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav">
  <button class="mobile-nav-close" id="mobileNavClose" aria-label="Закрыть">
    <svg viewBox="0 0 24 24" fill="none" stroke="var(--cream)" stroke-width="1.4"><line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/></svg>
  </button>
  <ul>
    <li><a href="#collection">Коллекция</a></li>
    <li><a href="#shop">Магазин</a></li>
    <li><a href="#about">О бренде</a></li>
    <li><a href="#news">Новости</a></li>
  </ul>
</div>

<section class="hero">
  <div class="hero-figure">
    <img src="https://images.unsplash.com/photo-1707834102707-88d81a04e2f7?fm=jpg&amp;q=80&amp;w=1400&amp;auto=format&amp;fit=crop" alt="Модель в чёрном костюме tabark" loading="eager" referrerpolicy="no-referrer">
  </div>
  <div class="wrap hero-body">
    <div class="hero-content">
      <div class="hero-eyebrow">Осень / Зима 2026</div>
      <h1 class="hero-title">tabark</h1>
      <p class="hero-sub">Дизайнерская одежда для тех, кто выбирает форму без лишнего слова — чистые линии, плотные ткани и характер в деталях.</p>
      <a href="#collection" class="hero-cta">Смотреть коллекцию
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
      </a>
    </div>
  </div>
  <div class="hero-scroll"><span class="line"></span>Вниз</div>
</section>

<section class="section" id="collection">
  <div class="wrap">
    <div class="section-head">
      <h2>Категории</h2>
      <p>Четыре капсулы сезона — от верхней одежды до трикотажа, собранные вокруг одной идеи простоты.</p>
    </div>
    <div class="cat-grid">

      <a href="#" class="cat-card">
        <div class="cat-frame">
          <img class="photo-cover" src="https://images.unsplash.com/photo-1604956152452-9404fdf107f1?fm=jpg&amp;q=80&amp;w=900&amp;auto=format&amp;fit=crop" alt="Верхняя одежда tabark — бежевое пальто" loading="lazy" referrerpolicy="no-referrer">
        </div>
        <div class="cat-name">Верхняя одежда
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </div>
      </a>

      <a href="#" class="cat-card">
        <div class="cat-frame">
          <img class="photo-cover" src="https://images.unsplash.com/photo-1545263531-627adacb882b?fm=jpg&amp;q=80&amp;w=900&amp;auto=format&amp;fit=crop" alt="Трикотаж tabark — вязаный свитер" loading="lazy" referrerpolicy="no-referrer">
        </div>
        <div class="cat-name">Трикотаж
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </div>
      </a>

      <a href="#" class="cat-card">
        <div class="cat-frame">
          <img class="photo-cover" src="https://images.unsplash.com/photo-1768818565983-29d3f4d76869?fm=jpg&amp;q=80&amp;w=900&amp;auto=format&amp;fit=crop" alt="Платья tabark — чёрное платье" loading="lazy" referrerpolicy="no-referrer" style="object-position:center 30%;">
        </div>
        <div class="cat-name">Платья
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </div>
      </a>

      <a href="#" class="cat-card">
        <div class="cat-frame">
          <img class="photo-cover" src="https://images.unsplash.com/photo-1707834102707-88d81a04e2f7?fm=jpg&amp;q=80&amp;w=900&amp;auto=format&amp;fit=crop" alt="Костюмы tabark — чёрный костюм" loading="lazy" referrerpolicy="no-referrer">
        </div>
        <div class="cat-name">Костюмы
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </div>
      </a>

    </div>
  </div>
</section>

<section class="feature" id="about">
  <div class="feature-media">
    <img src="https://images.unsplash.com/photo-1768818565983-29d3f4d76869?fm=jpg&amp;q=80&amp;w=1200&amp;auto=format&amp;fit=crop" alt="Философия tabark" loading="lazy" referrerpolicy="no-referrer">
  </div>
  <div class="feature-copy">
    <div class="kicker">О бренде</div>
    <h2>Простота — это выбор,<br>а не отсутствие идей.</h2>
    <p>tabark создаёт одежду для тех, кто ценит хорошо сшитую вещь больше, чем громкий логотип. Мы работаем с плотными натуральными тканями, ограниченной палитрой и посадкой, которая не требует объяснений.</p>
    <a href="#about" class="hero-cta">Подробнее о бренде
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
    </a>
  </div>
</section>

<section class="section section-tight" id="shop">
  <div class="wrap">
    <div class="strip">
      <div class="strip-intro">
        <div class="kicker">Новая коллекция</div>
        <h3>Весна /<br>Лето 2027</h3>
        <a href="#collection" class="hero-cta" style="color:var(--ink);border-color:var(--line);">Смотреть коллекцию
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>

      <div class="strip-frame">
        <img src="https://images.unsplash.com/photo-1707834102707-88d81a04e2f7?fm=jpg&amp;q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="tabark — костюм, весна-лето" loading="lazy" referrerpolicy="no-referrer">
      </div>
      <div class="strip-frame">
        <img src="https://images.unsplash.com/photo-1768818565983-29d3f4d76869?fm=jpg&amp;q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="tabark — платье, весна-лето" loading="lazy" referrerpolicy="no-referrer" style="object-position:center 25%;">
      </div>
      <div class="strip-frame">
        <img src="https://images.unsplash.com/photo-1604956152452-9404fdf107f1?fm=jpg&amp;q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="tabark — пальто, весна-лето" loading="lazy" referrerpolicy="no-referrer">
      </div>
    </div>
  </div>
</section>

<footer id="news">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-col">
        <div class="footer-brand">tabark</div>
        <ul>
          <li><a href="#">Помощь</a></li>
          <li><a href="#">Доставка и оплата</a></li>
          <li><a href="#">Возврат</a></li>
          <li><a href="#">Таблица размеров</a></li>
          <li><a href="#">Контакты</a></li>
        </ul>
      </div>
      <div class="footer-col newsletter">
        <h4>Подпишитесь на новости</h4>
        <p>Узнавайте первыми о новых коллекциях и закрытых предложениях tabark.</p>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="Ваш e-mail" required>
          <button type="submit" aria-label="Подписаться">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
          </button>
        </form>
      </div>
      <div class="footer-col">
        <h4>Мы в соцсетях</h4>
        <ul>
          <li><a href="#">Instagram</a></li>
          <li><a href="#">Telegram</a></li>
          <li><a href="#">Pinterest</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 tabark. Все права защищены. Фото: Unsplash.</span>
      <a href="#">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  const mobileNavClose = document.getElementById('mobileNavClose');

  function openMenu(){
    mobileNav.classList.add('open');
    menuToggle.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu(){
    mobileNav.classList.remove('open');
    menuToggle.classList.remove('open');
    document.body.style.overflow = '';
  }

  menuToggle.addEventListener('click', () => {
    mobileNav.classList.contains('open') ? closeMenu() : openMenu();
  });
  mobileNavClose.addEventListener('click', closeMenu);
  mobileNav.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>

</body>
</html>
